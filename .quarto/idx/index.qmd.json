</strong> — a graphical software for reproducible biogeographic analyses and cross-clade synthesis. <a href=\"https://github.com/XuWeiEvo/BioGeoSyn\">GitHub</a></span></li>\n  <li><span class=\"wx-venue\">Science 2026</span><span>Stop the biodiversity sampling arms race.</span></li>\n  <li><span class=\"wx-venue\">Biol. Conserv. 2026</span><span>Diversity, distribution and conservation of Annonaceae in Madagascar.</span></li>\n  <li><span class=\"wx-venue\">Proc. B 2025</span><span>Earth history and trait innovation drive the global radiation of modern toads.</span></li>\n  <li><span class=\"wx-venue\">PNAS 2024</span><span>Hidden hotspots of amphibian biodiversity in China.</span></li>\n</ul>\n\n<p class=\"wx-section-label\">Elsewhere</p>\n\n<div class=\"wx-actions\">\n  <a class=\"wx-btn\" href=\"https://orcid.org/0000-0002-4184-3982\">ORCID</a>\n  <a class=\"wx-btn\" href=\"https://scholar.google.com/citations?hl=en&amp;user=YOxNTyAAAAAJ\">Google Scholar</a>\n  <a class=\"wx-btn\" href=\"https://github.com/XuWeiEvo\">GitHub</a>\n  <a class=\"wx-btn\" href=\"https://www.researchgate.net/profile/Wei-Xu-312\">ResearchGate</a>\n</div>\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","m